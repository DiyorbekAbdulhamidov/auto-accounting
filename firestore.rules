rules_version = '2';

// Firestore xavfsizlik qoidalari.
//
// Muhim: klient bu bazaga API'ni CHETLAB O'TIB, to'g'ridan-to'g'ri yozadi
// (companies, sverka_reports). Ya'ni src/lib/apiAuth.ts dagi tekshiruv bu
// yo'lga TA'SIR QILMAYDI — yagona himoya shu fayl.
//
// Qoida apiAuth.ts bilan bir xil: Firebase'da login bo'lish yetarli emas,
// email `allowed_users` ro'yxatida va status "active" bo'lishi shart.
//
// Deploy:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ---- HISOB KALITI ----
    // Email bo'lsa email, bo'lmasa TELEFON RAQAMI (E.164, `+998...`).
    //
    // Nega shunday: SMS bilan kirganda `request.auth.token.email` NULL
    // bo'ladi. Ilgari bu yerda to'g'ridan-to'g'ri `token.email`
    // ishlatilardi, ya'ni telefon bilan kirgan odamda `isAllowed()`
    // false qaytarib butun ilova hamma narsani RAD ETARDI.
    //
    // Email USTUNLIKKA ega: bir hisobga ikkalasi ham bog'langan bo'lsa
    // kalit o'zgarmaydi va mavjud hujjatlar joyida qoladi.
    //
    // Ikkala qiymat ham Firebase tomonidan TASDIQLANGAN credential'dan
    // keladi — foydalanuvchi ularni o'zi qo'yib bo'lmaydi.
    // `.get(kalit, standart)` ATAYLAB — nuqta bilan EMAS.
    //
    // 2026-08-18 da o'lchandi: telefon bilan kirgan foydalanuvchining
    // tokenida `email` kaliti UMUMAN YO'Q (bo'sh satr ham emas):
    //   { phone_number: "+998...", firebase: { sign_in_provider: "phone" } }
    // Qoidalarda mavjud bo'lmagan kalitga `token.email` deb murojaat
    // qilish XATO beradi va butun qoida RAD ETADI — foydalanuvchi
    // «Missing or insufficient permissions» xabarini oladi, sababi esa
    // hech qayerda ko'rinmaydi.
    //
    // Standart qiymat '' (null emas): shunda mantiq klientdagi
    // `email || phone` bilan AYNAN bir xil bo'ladi — bo'sh satr ham,
    // yo'q kalit ham telefonga o'tkazadi.
    function authKey() {
      return request.auth.token.get('email', '') != ''
        ? request.auth.token.get('email', '')
        : request.auth.token.get('phone_number', '');
    }

    function userDoc() {
      return get(/databases/$(database)/documents/allowed_users/$(authKey())).data;
    }

    function isAllowed() {
      return request.auth != null
        && authKey() != ''
        && exists(/databases/$(database)/documents/allowed_users/$(authKey()))
        // status maydoni yo'q eski hujjatlar ham faol hisoblanadi (apiAuth.ts bilan bir xil)
        && userDoc().get('status', 'active') == 'active';
    }

    function isAdmin() {
      return isAllowed() && userDoc().get('role', 'user') == 'admin';
    }

    // ---- ISH MAYDONI (egalik) ----
    // 2026-08-13 gacha bu yerda egalik tekshiruvi UMUMAN yo'q edi: ro'yxatdagi
    // har bir foydalanuvchi BARCHA korxona va hisobotlarni o'qiy olardi.
    // Endi hujjat o'z ish maydonidan tashqariga ko'rinmaydi.
    //
    // MUHIM: ish maydoni HUJJATNING O'ZIDAN olinadi, foydalanuvchi
    // hujjatidan EMAS. Ya'ni «bu hujjat qaysi ish maydoniga tegishli va
    // men o'sha maydonning a'zosimanmi» deb so'raladi. Ilgari bu yerda
    // `myWorkspace()` yordamchisi ham turardi (foydalanuvchi hujjatidan
    // o'qiydigan), lekin u HECH QAYERDA ishlatilmasdi — deploy uni
    // «Unused function» deb ogohlantirardi va eng muhimi, o'quvchida
    // «egalik qaysi tomondan tekshiriladi?» degan chalkashlik
    // tug'dirardi. Olib tashlandi.
    function isMember(workspaceId) {
      return isAllowed()
        && workspaceId != null
        && workspaceId != ''
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(authKey()));
    }

    // Ish maydoni hujjatini a'zolar o'qiydi; yozish faqat Admin SDK orqali.
    match /workspaces/{workspaceId} {
      allow read: if isMember(workspaceId);
      allow write: if false;

      match /members/{accountKey} {
        allow read: if isMember(workspaceId);
        allow write: if false;
      }
    }

    // Ruxsat ro'yxati: har kim faqat O'Z hujjatini o'qiy oladi (AuthContext shuni qiladi).
    // Yozish faqat Admin SDK orqali — u qoidalarni chetlab o'tadi, shuning uchun bu yerda yopiq.
    //
    // Hujjat identifikatori = `authKey()`, ya'ni email YOKI telefon raqami.
    // Shuning uchun wildcard `{email}` emas, `{accountKey}` deb ataladi.
    match /allowed_users/{accountKey} {
      allow read: if request.auth != null && authKey() != '' && authKey() == accountKey;
      allow write: if false;
    }

    // MUHIM: `read` bu yerda ro'yxat so'rovlariga ham tegishli. Firestore
    // so'rovni hujjatlarni o'qimasdan tekshiradi, shuning uchun klient
    // HAR DOIM `where('workspaceId','==',...)` bilan so'rashi shart —
    // aks holda so'rov butunlay rad etiladi (jimgina bo'sh ro'yxat emas).
    // `create` ATAYLAB yopiq: reja cheklovi («3 tagacha korxona») hujjat
    // SANOG'iga bog'liq, qoidalar esa hujjatlarni sanay olmaydi. Shuning
    // uchun korxona faqat /api/companies orqali yaratiladi — u yerda
    // sanaladi va tekshiriladi. Klientdan yozish cheklovni chetlab
    // o'tish yo'li bo'lardi.
    match /companies/{companyId} {
      allow read, update: if isMember(resource.data.get('workspaceId', ''));
      allow create: if false;
      allow delete: if isMember(resource.data.get('workspaceId', ''));
    }

    // `delete` a'zoga OCHIQ (ilgari faqat admin edi). Ikki sabab:
    //
    //  1. Korxonani o'chirish ISHLAMAS EDI. `clients/page.tsx` firma
    //     bilan birga uning hisobotlarini ham `writeBatch` bilan
    //     o'chiradi — batch esa bitta amal rad etilsa BUTUNLAY yiqiladi.
    //     Ya'ni admin bo'lmagan foydalanuvchi korxonasini umuman
    //     o'chira olmasdi.
    //  2. Har «Сақлаш» YANGI hujjat yaratadi (900 KB gacha) va tiklash
    //     so'rovi ularning hammasini yuklab oladi. O'chirishsiz
    //     kolleksiya cheksiz o'sadi.
    //
    // `update` YOPIQ qoladi: saqlangan hisobot o'zgarmas hujjat —
    // uni tahrirlash emas, qayta saqlash kerak.
    match /sverka_reports/{reportId} {
      allow read: if isMember(resource.data.get('workspaceId', ''));
      allow create: if isMember(request.resource.data.get('workspaceId', ''));
      allow update: if isAdmin();
      allow delete: if isMember(resource.data.get('workspaceId', ''));
    }

    // KIRIM sverkasi hisobotlari — ATAYLAB alohida kolleksiya.
    //
    // Nega `sverka_reports` ga `kind` maydoni qo'shilmadi: eski
    // hujjatlarda bunday maydon YO'Q, Firestore esa maydoni yo'q
    // hujjatni `where('kind','==','out')` so'roviga QO'SHMAYDI.
    // Ya'ni chiqim tomonining butun tarixi jimgina yo'qolgandek
    // bo'lardi — loyihadagi eng qimmat xato turi.
    match /income_reports/{reportId} {
      allow read: if isMember(resource.data.get('workspaceId', ''));
      allow create: if isMember(request.resource.data.get('workspaceId', ''));
      allow update: if isAdmin();
      // Sabab yuqorida, `sverka_reports` da yozilgan.
      allow delete: if isMember(resource.data.get('workspaceId', ''));
    }

    // Kontragent bo'yicha boshlang'ich qoldiq (сальдо начальное).
    // `update` bu yerda OCHIQ (admin emas): qoldiqni buxgalterning
    // o'zi to'g'rilaydi va bu kundalik ish. Hisobotlardan farqi —
    // qoldiq bitta joyda turadi va tarixi kerak emas.
    match /opening_balances/{balanceId} {
      allow read: if isMember(resource.data.get('workspaceId', ''));
      allow create: if isMember(request.resource.data.get('workspaceId', ''));
      allow update: if isMember(resource.data.get('workspaceId', ''))
                    && request.resource.data.workspaceId == resource.data.workspaceId;
      allow delete: if isAdmin();
    }

    // «Ko'proq kerak» bosilgani — TALAB O'LCHOVI.
    // Yozish ochiq, O'QISH YOPIQ: bu ichki o'lchov, foydalanuvchiga
    // boshqalarning so'rovini ko'rsatishning hojati yo'q.
    match /plan_interest/{id} {
      allow create: if isMember(request.resource.data.get('workspaceId', ''));
      allow read, update, delete: if false;
    }

    // OYLIK SVERKA SANOG'I (`sverka_usage`) bu yerda ATAYLAB
    // ko'rsatilmagan — quyidagi umumiy qoida uni klient uchun
    // butunlay yopadi. Unga faqat server (admin SDK) yozadi, ya'ni
    // cheklovni brauzerdan o'zgartirib bo'lmaydi. Sanoq holati
    // foydalanuvchiga tahlil javobidagi `quota` orqali yetadi.

    // Qolgan hamma narsa yopiq
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
